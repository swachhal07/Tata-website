{
  "rewrites": [
    { "source": "/api/products",            "destination": "https://tata-website.onrender.com/api/products" },
    { "source": "/api/products/:path*",     "destination": "https://tata-website.onrender.com/api/products/:path*" },
    { "source": "/api/locations",           "destination": "https://tata-website.onrender.com/api/locations" },
    { "source": "/api/people",              "destination": "https://tata-website.onrender.com/api/people" },
    { "source": "/api/posts",               "destination": "https://tata-website.onrender.com/api/posts" },
    { "source": "/api/posts/:path*",        "destination": "https://tata-website.onrender.com/api/posts/:path*" },
    { "source": "/api/admin/:path*",        "destination": "https://tata-website.onrender.com/api/admin/:path*" },
    { "source": "/api/login",               "destination": "https://tata-website.onrender.com/api/login" },
    { "source": "/api/logout",              "destination": "https://tata-website.onrender.com/api/logout" },
    { "source": "/api/me",                  "destination": "https://tata-website.onrender.com/api/me" },
    { "source": "/((?!api/).*)",            "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ]
}
